{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-datagen"
		},
		"AzureBlobStorage1_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'AzureBlobStorage1'"
		},
		"LS_AzureDataLakeStorage1_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'LS_AzureDataLakeStorage1'"
		},
		"Ls_AzureSqlDatabase_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'Ls_AzureSqlDatabase'"
		},
		"LS_AzureBlobStorage_Keyvault_properties_typeProperties_connectionString_secretName": {
			"type": "string",
			"defaultValue": "adlsstorageaccountkey"
		},
		"LS_AzureDataLakeStorage1_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://blobdatgen.dfs.core.windows.net/"
		},
		"LS_AzureKeyVault1_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://datgenkeyvault.vault.azure.net/"
		},
		"LS_RESTAPI_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://jsonplaceholder.typicode.com/"
		},
		"Ls_AzureSqlDatabase_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "sql-datagen-server.database.windows.net"
		},
		"Ls_AzureSqlDatabase_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "AdventureWorks"
		},
		"Ls_AzureSqlDatabase_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "dbadmin"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adf-datagen_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"AzureBlobStorage1_connectionString": {
						"value": "[parameters('AzureBlobStorage1_connectionString')]"
					},
					"LS_AzureDataLakeStorage1_accountKey": {
						"value": "[parameters('LS_AzureDataLakeStorage1_accountKey')]"
					},
					"Ls_AzureSqlDatabase_password": {
						"value": "[parameters('Ls_AzureSqlDatabase_password')]"
					},
					"LS_AzureKeyVault1_properties_typeProperties_baseUrl": {
						"value": "[parameters('LS_AzureKeyVault1_properties_typeProperties_baseUrl')]"
					},
					"LS_AzureBlobStorage_Keyvault_properties_typeProperties_connectionString_secretName": {
						"value": "[parameters('LS_AzureBlobStorage_Keyvault_properties_typeProperties_connectionString_secretName')]"
					},
					"LS_AzureDataLakeStorage1_properties_typeProperties_url": {
						"value": "[parameters('LS_AzureDataLakeStorage1_properties_typeProperties_url')]"
					},
					"LS_RESTAPI_properties_typeProperties_url": {
						"value": "[parameters('LS_RESTAPI_properties_typeProperties_url')]"
					},
					"Ls_AzureSqlDatabase_properties_typeProperties_server": {
						"value": "[parameters('Ls_AzureSqlDatabase_properties_typeProperties_server')]"
					},
					"Ls_AzureSqlDatabase_properties_typeProperties_database": {
						"value": "[parameters('Ls_AzureSqlDatabase_properties_typeProperties_database')]"
					},
					"Ls_AzureSqlDatabase_properties_typeProperties_userName": {
						"value": "[parameters('Ls_AzureSqlDatabase_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
		},
		{
			"name": "adf-datagen_ArmTemplate_1",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_1.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					}
				}
			},
			"dependsOn": [
				"[resourceId('Microsoft.Resources/deployments', 'adf-datagen_ArmTemplate_0')]"
			]
		}
	]
}